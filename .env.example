# Copy to .env.local and fill in. Never commit real values.

# Google Apps Script Web App deployment URL (server-side only, proxied via /api/booking)
BOOKING_ENDPOINT_URL=

# Public site origin, used for canonical URL / sitemap / Open Graph.
# Leave unset on Vercel to auto-use the *.vercel.app production domain; set it to the
# real domain once that is attached. Locally, use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional). Leave blank to disable. Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
